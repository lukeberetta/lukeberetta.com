/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cache-Control: public, no-cache

# Filenames below are content-addressed or stable, so they can be cached hard.
# Everything else (HTML, CSS, JS) keeps its filename across deploys, so it must
# revalidate — otherwise a new index.html ships against a stale style.css.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable
